#!/bin/bash
# Auto-update cache version in service worker and index.html before commit

# Generate version from git commit count + short hash (e.g., "v42-a1b2c3d")
VERSION="v$(git rev-list --count HEAD)-$(git rev-parse --short HEAD)"

# Update sw.js with new version
sed -i.bak "s/const CACHE_VERSION = \".*\"/const CACHE_VERSION = \"$VERSION\"/" sw.js
rm -f sw.js.bak

# Update index.html query strings
sed -i.bak -E "s/\?v=v[0-9]+-[a-f0-9]+/?v=$VERSION/g" index.html
rm -f index.html.bak

# Stage updated files
for file in sw.js index.html; do
  if git diff --name-only "$file" | grep -q "$file"; then
    git add "$file"
    echo "✓ Updated $file to $VERSION"
  fi
done
